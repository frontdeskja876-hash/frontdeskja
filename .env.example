# Copy to .env (never commit it) or set these in your host's dashboard.
OPENAI_API_KEY=
# The saved "Ask FrontDesk" agent (platform.openai.com > Agents; the agent_... ID is in the page URL).
# Set it and the chat answers from that agent; leave it empty to use the Chat Completions fallback.
# The key must belong to the same OpenAI project as the agent.
AGENT_ID=
# Optional: comma-separated domains the agent's web search may use (empty = any site).
AGENT_ALLOWED_DOMAINS=
# Only used by the Chat Completions fallback (AGENT_ID empty); the agent has its own model setting.
OPENAI_MODEL=gpt-6.1-sol
LEAD_WEBHOOK_URL=
